# EduMechanic 3D - AI Multi-Modal & Backend Configuration

# Active VLM Provider: "auto" (default), "gemini", "openai", "anthropic", or "mock"
VLM_PROVIDER=auto

# Google Gemini API Key (Recommended for high-speed multi-modal VLM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude API Key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Mechanical 3D CAD Parametric Default Tolerance (mm)
DEFAULT_TOLERANCE=0.20
